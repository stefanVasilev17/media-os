FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build && npx vite build --config vite.voice.config.ts
RUN mv dist-voice/voice.html dist-voice/index.html

FROM maven:3.9-eclipse-temurin-21 AS backend
WORKDIR /backend
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
COPY --from=frontend /frontend/dist-voice ./src/main/resources/static
RUN mvn -B -ntp -Dstyle.color=never -DskipTests package > /tmp/build.log 2>&1 || { tail -100 /tmp/build.log; exit 1; }

FROM postgres:18
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend /backend/target/media-os-0.1.0-SNAPSHOT.jar /app/app.jar
COPY ops/release/ep002-voice-fresh-entrypoint.sh /app/entrypoint.sh
COPY ops/release/ep002-voice-fresh-smoke.sh /app/smoke.sh
RUN chmod 700 /app/entrypoint.sh /app/smoke.sh
RUN /app/smoke.sh && touch /voice-greenfield-pass
CMD ["bash","-c","echo EP002_FRESH_VOICE_QA_COMPLETE; sleep 12"]
