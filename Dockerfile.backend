FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline
COPY frontend/ ./
RUN npx vitest run src/components/Ep002LockedCutReviewRoom.test.ts src/lib/ep002VoiceCueAnchors.test.ts
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS backend-build
WORKDIR /backend
COPY backend/pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY backend/src ./src
COPY --from=frontend-build /frontend/dist ./src/main/resources/static
RUN date -u +"%Y-%m-%dT%H:%M:%SZ" > src/main/resources/media-os-build-time.txt
RUN MAVEN_OPTS="-Xmx768m -XX:MaxMetaspaceSize=320m" mvn -B -q -ntp -Dmaven.test.skip=true compile
RUN MAVEN_OPTS="-Xmx768m -XX:MaxMetaspaceSize=320m" mvn -B -ntp package

FROM backend-build AS postgres-verification
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postgresql postgresql-client && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    service postgresql start; \
    runuser -u postgres -- psql -v ON_ERROR_STOP=1 -c "CREATE USER media_os WITH LOGIN PASSWORD 'media_os'"; \
    runuser -u postgres -- createdb --owner=media_os media_os; \
    PGPASSWORD=media_os psql -h 127.0.0.1 -U media_os -d media_os -c "SELECT 1"; \
    CI_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/media_os MAVEN_OPTS="-Xmx640m -XX:MaxMetaspaceSize=320m" mvn -B test; \
    service postgresql stop

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN apk add --no-cache nodejs chromium ffmpeg xvfb nss freetype harfbuzz ttf-freefont ca-certificates mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium setpriv
COPY --from=postgres-verification /backend/target/media-os-0.1.0-SNAPSHOT.jar app.jar
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
COPY chromium-software-webgl.sh /app/chromium-software-webgl.sh
RUN chmod +x /app/docker-entrypoint.sh /app/chromium-software-webgl.sh
ENV CHROMIUM_PATH=/app/chromium-software-webgl.sh
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV GALLIUM_DRIVER=llvmpipe
ENV MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
EXPOSE 8080
ENTRYPOINT ["/app/docker-entrypoint.sh"]
