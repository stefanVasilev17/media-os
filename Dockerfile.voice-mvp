FROM node:22-alpine AS voice-frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build
RUN npx vite build --config vite.voice.config.ts
RUN mv dist-voice/voice.html dist-voice/index.html
RUN test -s dist-voice/index.html
RUN ! find dist-voice/assets -maxdepth 1 -iname '*SplineWorkspace*' -o -iname '*ShotRenderPage*' | grep -q .

FROM maven:3.9-eclipse-temurin-21 AS voice-backend
WORKDIR /backend
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
COPY --from=voice-frontend /frontend/dist-voice ./src/main/resources/static
RUN mvn -B -ntp -Dstyle.color=never -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=voice-backend /backend/target/media-os-0.1.0-SNAPSHOT.jar /app/app.jar
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70.0", "-jar", "/app/app.jar"]
