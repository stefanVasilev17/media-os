FROM node:22-alpine
WORKDIR /app/cumulative-engine
COPY cumulative-engine/package.json ./
RUN npm install --no-audit --no-fund --prefer-offline
COPY cumulative-engine/ ./
COPY remotion-engine/ep003-director-locked-visual-sequence-11.json /app/remotion-engine/ep003-director-locked-visual-sequence-11.json
COPY remotion-engine/ep003-director-locked-visual-sequence-10.json /app/remotion-engine/ep003-director-locked-visual-sequence-10.json
COPY remotion-engine/ep003-director-locked-visual-sequence.json /app/remotion-engine/ep003-director-locked-visual-sequence.json
RUN node --check ep003-assemble-master-11-locked.mjs
RUN node --test ep003-assemble-master-11-locked.test.mjs
RUN apk add --no-cache ffmpeg ca-certificates
CMD ["node","/app/cumulative-engine/ep003-assemble-master-11-locked.mjs"]
