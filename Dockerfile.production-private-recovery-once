FROM postgres:18
USER root
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace/backend
RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-21-jdk-headless maven coreutils python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/recovery-venv \
    && /opt/recovery-venv/bin/pip install --no-cache-dir --disable-pip-version-check boto3==1.35.76
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
COPY ops/release/backup_to_railway_bucket.py /workspace/backup_to_railway_bucket.py
COPY ops/release/persistent_production_backup_rehearsal.sh /workspace/run-recovery.sh
RUN mvn -B -ntp -Dstyle.color=never -DskipTests test-compile > /tmp/recovery-compile.log 2>&1 \
    || { tail -100 /tmp/recovery-compile.log; exit 1; }
RUN chmod 700 /workspace/run-recovery.sh
ENTRYPOINT ["/bin/bash", "/workspace/run-recovery.sh"]
