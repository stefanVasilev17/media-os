FROM node:22-alpine AS remotion-build
WORKDIR /app/remotion-engine
COPY remotion-engine/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline
COPY remotion-engine/ ./
RUN node --check cpu-worker.mjs
RUN node --test worker-token-rotation.test.mjs cpu-worker-lease.test.mjs worker-claim-authorization.test.mjs shot01-readability.test.mjs factory-media-worker.test.mjs validate-factory-scenes.test.mjs
RUN npm run generate:factory
RUN node validate-factory-scenes.mjs
RUN node build-typecheck-preflight.mjs
RUN npm run build
RUN npm run build:factory
RUN npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache chromium ffmpeg xvfb nss freetype harfbuzz ttf-freefont ca-certificates mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium setpriv
COPY --from=remotion-build /app/remotion-engine /app/remotion-engine
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
COPY chromium-software-webgl.sh /app/chromium-software-webgl.sh
RUN chmod +x /app/docker-entrypoint.sh /app/chromium-software-webgl.sh
ENV MEDIA_OS_PROCESS_ROLE=render-worker
ENV CHROMIUM_PATH=/app/chromium-software-webgl.sh
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV GALLIUM_DRIVER=llvmpipe
ENV MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
ENTRYPOINT ["/app/docker-entrypoint.sh"]
