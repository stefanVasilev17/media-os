FROM node:22 AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS backend
WORKDIR /backend
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
COPY --from=frontend /frontend/dist ./src/main/resources/static
RUN mvn -B -ntp -Dstyle.color=never -DskipTests package > /tmp/build-ep002.log 2>&1 || { tail -100 /tmp/build-ep002.log; exit 1; }

FROM postgres:18 AS smoke
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend /backend/target/media-os-0.1.0-SNAPSHOT.jar /app/app.jar
COPY ops/release/ep002-release-runtime-smoke.sh /app/run-smoke.sh
RUN chmod 700 /app/run-smoke.sh && /app/run-smoke.sh && touch /ep002-runtime-pass

FROM alpine:3.20
COPY --from=smoke /ep002-runtime-pass /ep002-runtime-pass
CMD ["sh","-c","echo EP002_RELEASE_RUNTIME_SMOKE_IMAGE_VERIFIED; sleep 12"]
