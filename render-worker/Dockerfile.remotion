FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app/remotion-engine
COPY remotion-engine/package*.json ./
RUN npm install --omit=dev
COPY remotion-engine/ ./

ENV NODE_ENV=production
ENV CHROMIUM_PATH=/usr/bin/chromium

CMD ["node", "/app/remotion-engine/cpu-worker.mjs"]
