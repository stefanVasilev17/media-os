FROM maven:3.9-eclipse-temurin-21
WORKDIR /backend
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
ENV MAVEN_OPTS="-Xmx512m"
RUN mvn -B -ntp -Dstyle.color=never -DargLine=-Xmx384m \
  -Dtest=EpisodeLockedScriptVoiceServiceTest,EpisodeDirectorOverviewControllerTest,ShotRevisionAgentControllerTest \
  test > /tmp/voice-origin-tests.log 2>&1 \
  || { echo EP002_ORIGINAL_VOICE_CI=FAIL; tail -160 /tmp/voice-origin-tests.log; exit 1; }
RUN grep 'Tests run:' /tmp/voice-origin-tests.log | tail -5 && echo EP002_ORIGINAL_VOICE_CI=PASS
CMD ["sh","-c","echo TESTS_COMPLETED; sleep 15"]
