FROM node:22-alpine AS benchmark-deps
WORKDIR /app/remotion-engine
COPY remotion-engine/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline
COPY remotion-engine/ ./

FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache chromium ffmpeg xvfb nss freetype harfbuzz ttf-freefont ca-certificates mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium setpriv
COPY --from=benchmark-deps /app/remotion-engine /app/remotion-engine
COPY chromium-software-webgl.sh /app/chromium-software-webgl.sh
RUN chmod +x /app/chromium-software-webgl.sh
ENV CHROMIUM_PATH=/app/chromium-software-webgl.sh
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV GALLIUM_DRIVER=llvmpipe
ENV MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
ENV MEDIA_OS_BENCH_COMPOSITION=EP001-PhoneFirst-Youtube
ENV MEDIA_OS_BENCH_FRAMES=180
ENTRYPOINT ["node", "/app/remotion-engine/benchmark-concurrency.mjs"]
