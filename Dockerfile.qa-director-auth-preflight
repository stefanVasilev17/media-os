FROM postgres:18
USER root
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace/backend
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jdk-headless maven coreutils && rm -rf /var/lib/apt/lists/*
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
ENV MAVEN_OPTS="-Xmx512m"
RUN set -eu; \
    mkdir -p /tmp/pg-director; \
    chown postgres:postgres /tmp/pg-director; \
    runuser -u postgres -- /usr/lib/postgresql/18/bin/initdb -D /tmp/pg-director -A trust > /tmp/director-init.log; \
    runuser -u postgres -- /usr/lib/postgresql/18/bin/pg_ctl -D /tmp/pg-director -o "-h 127.0.0.1 -p 5432" -w start > /tmp/director-pg.log; \
    runuser -u postgres -- psql -h 127.0.0.1 -v ON_ERROR_STOP=1 -c "CREATE ROLE media_os LOGIN PASSWORD 'media_os'"; \
    runuser -u postgres -- createdb -h 127.0.0.1 -O media_os media_os; \
    CI_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/media_os \
      mvn -B -ntp -Dstyle.color=never -DargLine=-Xmx384m \
      -Dtest=LocalDirectorHttpLifecycleTest,LocalDirectorIntegrationTest,LocalDirectorOfflineMaintenanceTest,LocalTotpCryptoTest,LocalTotpTest,LocalAuthenticationModeGuardTest,DirectorSecurityConfigurationTest,DirectorHttpAuthorizationTest,DirectorSecurityMigrationTest \
      test > /tmp/director-auth-preflight.log 2>&1 \
      || { echo DIRECTOR_AUTH_PREFLIGHT=FAIL; tail -130 /tmp/director-auth-preflight.log; exit 1; }; \
    grep 'Tests run:' /tmp/director-auth-preflight.log | tail -1; \
    echo DIRECTOR_AUTH_PREFLIGHT=PASS
CMD ["sh", "-c", "echo DIRECTOR_AUTH_CI_ONLY; sleep 15"]
