{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediaos.local/schemas/mediaos-episode-package-v1.schema.json",
  "title": "MediaOS Episode Package v1 — Director-approved script and visual storyline",
  "description": "A content-only source package prepared with the Director before any voice or AI video production. Import never authorizes paid calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episode",
    "sourceApproval",
    "visualIdentity",
    "shots",
    "shortsCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mediaos.episode-package.v1"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeKey",
        "title",
        "language",
        "audience",
        "targetDurationSeconds"
      ],
      "properties": {
        "episodeKey": {
          "type": "string",
          "pattern": "^EP[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        },
        "language": {
          "const": "en"
        },
        "audience": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "targetDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "subjectCluster": {
          "type": "string",
          "maxLength": 140
        }
      }
    },
    "sourceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "visualStoryline"
      ],
      "properties": {
        "script": {
          "const": "DIRECTOR_APPROVED"
        },
        "visualStoryline": {
          "const": "DIRECTOR_APPROVED"
        },
        "approvalNotes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "visualIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "styleReference",
        "continuityRules"
      ],
      "properties": {
        "styleReference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "continuityRules": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2500
        },
        "reuseAssetKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxItems": 200
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotKey",
          "title",
          "editorialDurationSeconds",
          "narration",
          "voiceDirection",
          "visualGoal",
          "cameraDirection",
          "visualBeats",
          "transition"
        ],
        "properties": {
          "shotKey": {
            "type": "string",
            "pattern": "^SHOT(0[1-9]|[1-3][0-9]|40)$"
          },
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 180
          },
          "editorialDurationSeconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 400
          },
          "narration": {
            "type": "string",
            "minLength": 20,
            "maxLength": 12000
          },
          "voiceDirection": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1200
          },
          "visualGoal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1500
          },
          "startingFrame": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1500
          },
          "cameraDirection": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2200
          },
          "assetKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 100
          },
          "visualBeats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "beatId",
                "cueAnchor",
                "direction"
              ],
              "properties": {
                "beatId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "cueAnchor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "description": "Literal narration anchor, not fabricated alignment timestamps."
                },
                "direction": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 3000
                },
                "assets": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "maxItems": 80
                }
              }
            }
          },
          "transition": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1200
          },
          "shortsCandidate": {
            "type": "boolean"
          }
        }
      }
    },
    "shortsCandidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "shotKeys",
          "hook"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 160
          },
          "shotKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SHOT(0[1-9]|[1-3][0-9]|40)$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "hook": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        }
      }
    }
  }
}
