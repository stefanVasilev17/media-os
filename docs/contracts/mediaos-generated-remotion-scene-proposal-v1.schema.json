{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediaos.local/contracts/mediaos-generated-remotion-scene-proposal-v1.schema.json",
  "title": "MediaOS — Generic Remotion Scene Proposal Contract v1",
  "description": "Future OpenAI worker output. Validation of this document does NOT authorize writing to GitHub, running code, spending provider credits, rendering or merging.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "episodeKey",
    "shotKey",
    "sourceReadinessFingerprint",
    "assetCatalogSha256",
    "pinnedGitCommit",
    "outputPath",
    "componentExport",
    "audioTakeId",
    "durationInFrames",
    "video",
    "verifiedCues",
    "reuseComponents",
    "newAssetKeys",
    "tsxSource",
    "reviewStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mediaos.generated-remotion-scene-proposal.v1"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "episodeKey": {
      "type": "string",
      "pattern": "^EP(?!001$|002$)[0-9]{3,}$"
    },
    "shotKey": {
      "type": "string",
      "pattern": "^SHOT(0[1-9]|[1-3][0-9]|40)$"
    },
    "sourceReadinessFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetCatalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pinnedGitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "outputPath": {
      "type": "string",
      "pattern": "^remotion-engine/src/episodes/ep[0-9]{3,}/Shot(0[1-9]|[1-3][0-9]|40)GeneratedScene\\.tsx$"
    },
    "componentExport": {
      "type": "string",
      "pattern": "^Shot(0[1-9]|[1-3][0-9]|40)GeneratedScene$"
    },
    "audioTakeId": {
      "type": "string",
      "format": "uuid"
    },
    "durationInFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 108000
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps",
        "width",
        "height",
        "colorSpace"
      ],
      "properties": {
        "fps": {
          "const": 30
        },
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "colorSpace": {
          "const": "REC709"
        }
      }
    },
    "verifiedCues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beatId",
          "anchor",
          "startFrame",
          "endFrame"
        ],
        "properties": {
          "beatId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reuseComponents": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AT[A-Za-z0-9]{2,60}$"
      }
    },
    "newAssetKeys": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "tsxSource": {
      "type": "string",
      "minLength": 100,
      "maxLength": 80000
    },
    "reviewStatus": {
      "const": "PROPOSAL_UNTRUSTED_NEEDS_ISOLATED_TYPECHECK_AND_DIRECTOR_REVIEW"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "episodeKey": {
            "const": "EP001"
          }
        }
      },
      "then": false
    },
    {
      "if": {
        "properties": {
          "episodeKey": {
            "const": "EP002"
          }
        }
      },
      "then": false
    }
  ]
}
