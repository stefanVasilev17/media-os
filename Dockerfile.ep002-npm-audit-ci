FROM node:22-alpine
WORKDIR /qa
COPY remotion-engine/package*.json /qa/remotion-engine/
COPY frontend/package*.json /qa/frontend/
RUN set -eu; \
    cd /qa/remotion-engine; \
    npm install --ignore-scripts --no-audit --no-fund >/tmp/remotion-install.log 2>&1; \
    (npm audit --json > /tmp/remotion-audit.json || true); \
    node -e 'const a=require("/tmp/remotion-audit.json");console.log("QA_NPM_AUDIT_REMOTION_TOTAL="+JSON.stringify(a.metadata?.vulnerabilities||{}));for(const [n,x] of Object.entries(a.vulnerabilities||{})){if(x.severity==="high"||x.severity==="critical")console.log("QA_NPM_AUDIT_REMOTION_PACKAGE="+JSON.stringify({name:n,severity:x.severity,isDirect:x.isDirect,fixAvailable:x.fixAvailable,via:x.via.map(y=>typeof y==="string"?y:y.name).slice(0,5)}));}' ; \
    cd /qa/frontend; \
    npm install --ignore-scripts --no-audit --no-fund >/tmp/frontend-install.log 2>&1; \
    (npm audit --json > /tmp/frontend-audit.json || true); \
    node -e 'const a=require("/tmp/frontend-audit.json");console.log("QA_NPM_AUDIT_FRONTEND_TOTAL="+JSON.stringify(a.metadata?.vulnerabilities||{}));for(const [n,x] of Object.entries(a.vulnerabilities||{})){if(x.severity==="high"||x.severity==="critical")console.log("QA_NPM_AUDIT_FRONTEND_PACKAGE="+JSON.stringify({name:n,severity:x.severity,isDirect:x.isDirect,fixAvailable:x.fixAvailable,via:x.via.map(y=>typeof y==="string"?y:y.name).slice(0,5)}));}' ; \
    echo QA_NPM_AUDIT_TRIAGE_COMPLETE=PASS
CMD ["sh","-c","echo 'QA dependencies audited in build; no application or production data'; sleep 10"]
